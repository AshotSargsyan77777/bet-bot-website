# Copy to .env and fill in. Never commit .env.

# ---------- Django ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 only for local development. Production must use 0.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated, e.g. https://goalking.example.com (needed for Django admin login behind HTTPS)
CSRF_TRUSTED_ORIGINS=
# Only needed when the SPA is served from a different origin than the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Set to 0 only if TLS is not terminated in front of the app (not recommended)
SECURE_SSL_REDIRECT=1

# ---------- PostgreSQL (default database) ----------
POSTGRES_DB=goalking
POSTGRES_USER=goalking
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# USE_SQLITE=1 switches to a local SQLite file (quick experiments only)
USE_SQLITE=0

# ---------- Redis / Celery ----------
# USE_LOCMEM_CACHE=1 runs without Redis (single process dev only)
USE_LOCMEM_CACHE=1
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# ---------- Auth ----------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ---------- Goalking business config ----------
# Shared secret for the n8n webhook (X-Internal-Key header)
N8N_INTERNAL_KEY=
# Card number shown to logged-in users on the payment page
CARD_NUMBER=
# Private Telegram VIP channel invite (revealed only to VIP members)
VIP_CHANNEL_LINK=
PROMO_FROM_3X=0
PROMOS_PER_UPDATE=1
RECEIPT_MAX_MB=5

# ---------- Telegram (same bot as index.js) ----------
# Telegram login button + notifications. In @BotFather run /setdomain and enter the site domain.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. goalking_bot
TELEGRAM_BOT_USERNAME=
# Public site address used in notification links (on Railway it is detected automatically)
SITE_URL=

# ---------- API-Football (https://www.api-football.com/) ----------
API_FOOTBALL_KEY=
# Leagues shown on the site (API-Football ids, same as the bot). Default: top 5, UCL, UEL, UECL, World Cup, Euro, Nations League
GAMES_LEAGUE_IDS=39,140,135,78,61,2,3,848,1,4,5
FORM_STATS_TTL_MINUTES=360

# ---------- Frontend (build time) ----------
# Leave empty when the SPA and API share a domain (nginx in docker-compose.prod.yml / Vite proxy in dev)
VITE_API_URL=

# ---------- Telegram bot (index.js, separate service) ----------
BOT_TOKEN=
# Comma separated Telegram chat ids of admins
ADMIN_ID=
RENDER_EXTERNAL_URL=
DATA_DIR=.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
